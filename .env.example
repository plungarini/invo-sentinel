# --- Required ---

# Invo refresh token (~350 day TTL). Extract from app.invoapp.com's
# FlutterSecureStorage in Chrome DevTools; see README "Credentials" section.
INVO_REFRESH_TOKEN=eyJ...your-refresh-token-here

# Hyperliquid phantom agent private key (~90 day TTL). From IndexedDB
# invo_hl_agents -> agents -> current -> privateKey.
HL_AGENT_KEY=0x...your-agent-private-key-here

# Your Hyperliquid master wallet address. DevTools → Application → Local
# Storage → value of `flutter.hl.masterAddress`
WALLET_ADDRESS=0x...your-wallet-address-here

# --- Risk (every mirrored trade's margin is clamped into this %-of-equity
# band, regardless of what % the trader used; leverage is capped, never
# rejected; trades are never skipped outright, only resized - except the
# stale-entry rule below, the one deliberate exception) ---

MIN_MARGIN_PCT=2
MAX_MARGIN_PCT=5

# Leave blank for no leverage cap.
MAX_LEVERAGE=30

# --- Stale-entry skip (the one deliberate exception to "never skipped") ---

# A trader's investment older than STALE_ENTRY_MAX_AGE_MINUTES is skipped
# PERMANENTLY, regardless of its current PnL - age alone disqualifies it.
# Prevents e.g. a same-coin conflict clearing and suddenly opening a rival
# trader's long-since-opened trade idea at 0% PnL and full size, whatever
# its PnL happens to be at that exact moment. Once permanently skipped,
# that baseId is ignored for the rest of its life (until it closes on the
# trader's side); never retried.
#
# Within that age window, an investment already up more than
# STALE_ENTRY_MAX_PROFIT_PCT% (its own leveraged PnL%) is also skipped, but
# only for the current cycle - re-checked fresh next cycle while still
# inside the window.
STALE_ENTRY_MAX_AGE_MINUTES=1
STALE_ENTRY_MAX_PROFIT_PCT=1

# --- Polling ---

# How often the daemon polls Invo, in milliseconds. Invo's own systems have
# some inherent latency, so going much below 2000 mostly burns API calls
# without cutting real-world latency.
POLL_INTERVAL_MS=5000

# --- Logs (logs/ directory, both limits enforced together) ---

LOG_RETENTION_HOURS=24
LOG_MAX_TOTAL_MB=200

# --- Optional external monitoring (dead man's switch) ---

# A ping URL from a service like healthchecks.io. When set, the daemon
# pings <url>/start at the beginning of every poll cycle and <url> (success)
# or <url>/fail at the end - lets the monitor alert you immediately if the
# process stops running or a cycle errors, and shows per-cycle run time.
# Leave blank to disable; adds no behavior at all when unset.
HEALTHCHECK_PING_URL=

# --- Dashboard UI (read via ui/.env.local, see ui/.env.local.example) ---

UI_PORT=4400
