# --- Required ---

# Invo refresh token (~350 day TTL). Extract from app.invoapp.com's
# FlutterSecureStorage in Chrome DevTools; see README "Credentials" section.
INVO_REFRESH_TOKEN=eyJ...your-refresh-token-here

# Hyperliquid phantom agent private key (~90 day TTL). From IndexedDB
# invo_hl_agents -> agents -> current -> privateKey.
HL_AGENT_KEY=0x...your-agent-private-key-here

# Your Hyperliquid master wallet address. From your Invo profile, or the
# refresh token's JWT payload (trading_account.wallet_address).
WALLET_ADDRESS=0x...your-wallet-address-here

# --- Risk (every mirrored trade's margin is clamped into this %-of-equity
# band, regardless of what % the trader used; leverage is capped, never
# rejected; trades are never skipped outright, only resized) ---

MIN_MARGIN_PCT=2
MAX_MARGIN_PCT=5

# Leave blank for no leverage cap.
MAX_LEVERAGE=30

# --- Polling ---

# How often the daemon polls Invo, in milliseconds. Invo's own systems have
# some inherent latency, so going much below 2000 mostly burns API calls
# without cutting real-world latency.
POLL_INTERVAL_MS=5000

# --- Logs (logs/ directory, both limits enforced together) ---

LOG_RETENTION_HOURS=24
LOG_MAX_TOTAL_MB=200
