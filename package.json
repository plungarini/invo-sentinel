{
	"name": "invo-sentinel",
	"version": "1.5.0",
	"description": "Automatic copy trader for Invo followed portfolios, executing on Hyperliquid.",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"preflight": "tsx src/cli/preflight.ts",
		"start": "tsx src/cli/auto-copy.ts",
		"dry-run": "tsx src/cli/auto-copy.ts --dry-run",
		"adopt": "tsx src/cli/adopt.ts",
		"close": "tsx src/cli/close-position.ts",
		"reconcile": "tsx src/cli/reconcile.ts",
		"typecheck": "tsc --noEmit",
		"ui:dev": "npm run dev --prefix ui",
		"ui:build": "npm run build --prefix ui",
		"ui:start": "npm run start --prefix ui",
		"ui:typecheck": "tsc --noEmit --project ui"
	},
	"dependencies": {
		"hyperliquid": "^1.7.7",
		"undici": "^7.29.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"dotenv": "^17.4.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2"
	}
}
